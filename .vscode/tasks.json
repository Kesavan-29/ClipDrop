{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Clipdrop",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["${workspaceFolder}/app.py"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "flask",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Running on http://.*",
                    "endsPattern": ".*Running on http://.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}